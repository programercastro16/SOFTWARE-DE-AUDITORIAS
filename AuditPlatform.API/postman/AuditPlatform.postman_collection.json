              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Thomas Castro\",\n  \"email\": \"thomas.admin@demo.com\",\n  \"password\": \"Admin123!\",\n  \"role\": \"ADMIN\"\n}"
            },
            "url": "{{api_base}}/auth/users",
            "description": "Cambia email y password. Si el correo ya existe, verás error 400."
          }
        },

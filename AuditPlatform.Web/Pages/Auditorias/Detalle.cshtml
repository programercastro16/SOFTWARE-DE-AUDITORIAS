@page "{id:int}"
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = "Acta de auditoría";
    var apiBase = (Configuration["ApiBaseUrl"] ?? "http://localhost:5141").TrimEnd('/');
    var auditId = RouteData.Values["id"]?.ToString() ?? "0";
}

<div class="mb-3">
    <a class="btn btn-sm btn-glow" asp-page="/Auditorias/Index">← Volver al listado</a>
</div>
<div id="det-alert" class="alert d-none mb-3 border-0"></div>

<div id="det-shell" class="d-none">
    <div id="det-head" class="hero-panel mb-4"></div>
    <div class="glass-card p-4 p-md-5 text-center acta-launch-card">
        <p class="text-white fw-semibold mb-2">Acta de auditoría interna</p>
        <p class="small mb-4 mx-auto" style="max-width: 36rem; color: var(--ap-muted);">
            El formulario sigue el formato por aspectos (A, AR, I), observaciones y cálculo de % de cumplimiento.
            Se abre en una ventana para que completes con calma y veas el avance.
        </p>
        <button type="button" class="btn btn-gradient btn-lg px-5" id="btn-open-acta">Abrir acta de auditoría</button>
    </div>
</div>

<div id="acta-modal" class="acta-modal d-none" aria-hidden="true">
    <div class="acta-modal-backdrop" id="acta-modal-backdrop" tabindex="-1"></div>
    <div class="acta-modal-dialog glass-card border-0" role="dialog" aria-modal="true" aria-labelledby="acta-modal-title">
        <div class="acta-modal-toolbar">
            <div>
                <p class="small text-uppercase mb-1" style="letter-spacing: .18em; color: var(--ap-muted);">Carrascal Zamarra · Formato tipo acta</p>
                <h2 id="acta-modal-title" class="h5 text-white mb-0">FORMATO ACTA DE AUDITORÍA INTERNA</h2>
            </div>
            <button type="button" class="btn btn-glow btn-sm" id="acta-modal-close" aria-label="Cerrar">✕</button>
        </div>
        <div class="acta-modal-progress px-3 py-3 border-bottom border-secondary border-opacity-25">
            <div class="d-flex justify-content-between small mb-1" style="color: var(--ap-muted);">
                <span>Progreso (ítems calificados)</span>
                <span id="acta-prog-label" class="text-white fw-semibold">0%</span>
            </div>
            <div class="acta-progress-track mb-3"><div id="acta-prog-bar" class="acta-progress-bar" style="width:0%"></div></div>
            <div class="d-flex flex-wrap justify-content-between gap-2 small">
                <span style="color: var(--ap-muted);">% Cumplimiento (sobre puntos máx.): <strong class="text-white" id="acta-cump-label">0%</strong></span>
                <span id="acta-concepto" class="fw-semibold">—</span>
            </div>
            <p class="small mb-0 mt-2" style="color: var(--ap-muted); opacity: .85;">
                <strong class="text-white">A</strong> aceptable pleno · <strong class="text-white">AR</strong> aceptable con observación · <strong class="text-white">I</strong> inaceptable.
                Concepto: favorable ≥90% · favorable con requerimiento 60–89.9% · desfavorable &lt;60%.
            </p>
        </div>
        <div class="acta-modal-body" id="acta-modal-body"></div>
        <div class="acta-modal-footer">
            <button type="button" class="btn btn-glow" id="acta-modal-close-2">Cerrar</button>
            <button type="button" class="btn btn-gradient px-4" id="acta-btn-save">Guardar acta</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const API = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(apiBase));
            const AUDIT_ID = parseInt(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(auditId)), 10);
            const token = sessionStorage.getItem('audit_access_token');
            const alertEl = document.getElementById('det-alert');
            let auditData = null;

            function show(msg, ok) {
                alertEl.className = 'alert mb-3 border-0 ' + (ok ? 'alert-success' : 'alert-danger');
                alertEl.style.background = ok ? 'rgba(61,214,140,.15)' : 'rgba(255,107,138,.12)';
                alertEl.style.color = ok ? '#b8ffd9' : '#ffc4d0';
                alertEl.textContent = msg;
                alertEl.classList.remove('d-none');
            }

            if (!token || !AUDIT_ID) { show('Falta sesión o ID de auditoría.', false); return; }

            function escapeHtml(s) {
                return String(s || '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
            }
            function escapeTpl(s) {
                return String(s || '').replace(/\\/g, '\\\\').replace(/`/g, '\\`').replace(/\$\{/g, '\\${');
            }
            function safe(s) { return escapeTpl(escapeHtml(s)); }
            function fmtNum(n) {
                const x = Number(n);
                return Math.abs(x - Math.round(x)) < 0.001 ? String(Math.round(x)) : String(x);
            }
            function nearly(a, b) { return Math.abs(a - b) < 0.02; }

            function triple(it) {
                const pa = Number(it.pointsA), par = Number(it.pointsAR), pi = Number(it.pointsI);
                if (pa > 0 || par > 0 || pi > 0) return [pa, par, pi];
                const w = Number(it.weight) || 0;
                return [w, Math.round(w / 2 * 100) / 100, 0];
            }

            function groupByCategory(items) {
                const m = {};
                (items || []).forEach(i => {
                    const c = i.category || 'GENERAL';
                    if (!m[c]) m[c] = [];
                    m[c].push(i);
                });
                return m;
            }

            function updateActaStats() {
                const sets = document.querySelectorAll('#acta-modal-body fieldset.acta-item');
                const total = sets.length;
                let answered = 0, earned = 0, maxSum = 0;
                sets.forEach(fs => {
                    const pa = parseFloat(fs.dataset.pa), par = parseFloat(fs.dataset.par), pi = parseFloat(fs.dataset.pi);
                    maxSum += pa;
                    const r = fs.querySelector('input[type="radio"]:checked');
                    if (r) {
                        answered++;
                        earned += parseFloat(r.value, 10) || 0;
                    }
                });
                const prog = total ? Math.round(answered / total * 1000) / 10 : 0;
                const cump = maxSum > 0 ? Math.round(earned / maxSum * 1000) / 10 : 0;
                document.getElementById('acta-prog-label').textContent = prog + '%';
                document.getElementById('acta-prog-bar').style.width = prog + '%';
                document.getElementById('acta-cump-label').textContent = cump + '%';
                let conc = '—';
                if (answered === total && total > 0) {
                    if (cump >= 90) conc = 'Favorable';
                    else if (cump >= 60) conc = 'Favorable con requerimiento';
                    else conc = 'Desfavorable';
                }
                document.getElementById('acta-concepto').textContent = conc;
                document.getElementById('acta-concepto').className = 'fw-semibold ' + (conc === 'Favorable' ? 'text-success' : conc.indexOf('requerimiento') >= 0 ? 'text-warning' : conc === 'Desfavorable' ? 'text-danger' : 'text-secondary');
            }

            function buildActaBody() {
                const groups = groupByCategory(auditData.items);
                const body = document.getElementById('acta-modal-body');
                body.innerHTML = Object.keys(groups).map(cat => {
                    const items = groups[cat];
                    return '<section class="acta-section mb-4"><h3 class="acta-section-title">' + safe(cat) + '</h3>' +
                        items.map(it => {
                            const [pa, par, pi] = triple(it);
                            const sc = Number(it.score);
                            const chkA = nearly(sc, pa) ? ' checked' : '';
                            const chkAR = nearly(sc, par) ? ' checked' : '';
                            const chkI = nearly(sc, pi) ? ' checked' : '';
                            const unset = sc < -0.5;
                            const cA = unset ? '' : chkA;
                            const cAR = unset ? '' : chkAR;
                            const cI = unset ? '' : chkI;
                            return '<fieldset class="acta-item mb-4 pb-4 border-bottom border-secondary border-opacity-25" data-item-id="' + it.id + '" data-pa="' + pa + '" data-par="' + par + '" data-pi="' + pi + '">' +
                                '<div class="row g-3 align-items-start">' +
                                '<div class="col-lg-6"><div class="d-flex gap-2 mb-1"><span class="badge bg-dark border border-secondary">' + safe(it.code) + '</span></div>' +
                                '<p class="text-white mb-0 small">' + safe(it.label) + '</p></div>' +
                                '<div class="col-lg-6">' +
                                '<p class="small text-uppercase mb-2" style="color:var(--ap-muted); letter-spacing:.1em;">Calificación</p>' +
                                '<div class="acta-circles d-flex flex-wrap gap-3">' +
                                '<label class="acta-circle"><input type="radio" name="acta-it-' + it.id + '" value="' + pa + '"' + cA + ' /><span class="acta-circle-ui"><span class="acta-circle-num">' + fmtNum(pa) + '</span><span class="acta-circle-lbl">A</span></span></label>' +
                                '<label class="acta-circle"><input type="radio" name="acta-it-' + it.id + '" value="' + par + '"' + cAR + ' /><span class="acta-circle-ui"><span class="acta-circle-num">' + fmtNum(par) + '</span><span class="acta-circle-lbl">AR</span></span></label>' +
                                '<label class="acta-circle"><input type="radio" name="acta-it-' + it.id + '" value="' + pi + '"' + cI + ' /><span class="acta-circle-ui"><span class="acta-circle-num">' + fmtNum(pi) + '</span><span class="acta-circle-lbl">I</span></span></label>' +
                                '</div>' +
                                '<label class="form-label small mt-3" style="color:var(--ap-muted)">Observaciones</label>' +
                                '<textarea class="form-control audit-input acta-obs" rows="2" data-obs-for="' + it.id + '" placeholder="Hallazgos u observaciones del aspecto…">' + escapeHtml(it.observations || '') + '</textarea>' +
                                '</div></div></fieldset>';
                        }).join('') + '</section>';
                }).join('');
                updateActaStats();
            }

            document.getElementById('acta-modal').addEventListener('change', function (e) {
                if (e.target && e.target.matches && e.target.matches('input[type="radio"]')) updateActaStats();
            });
            document.getElementById('acta-modal').addEventListener('input', function (e) {
                if (e.target && e.target.classList && e.target.classList.contains('acta-obs')) updateActaStats();
            });

            function openActa() {
                buildActaBody();
                const m = document.getElementById('acta-modal');
                m.classList.remove('d-none');
                m.setAttribute('aria-hidden', 'false');
                document.body.classList.add('acta-modal-open');
                updateActaStats();
            }
            function closeActa() {
                const m = document.getElementById('acta-modal');
                m.classList.add('d-none');
                m.setAttribute('aria-hidden', 'true');
                document.body.classList.remove('acta-modal-open');
            }

            async function load() {
                try {
                    const res = await fetch(API + '/audits/' + AUDIT_ID, { headers: { 'Authorization': 'Bearer ' + token } });
                    if (res.status === 404) { show('No existe o no tienes acceso.', false); return; }
                    if (!res.ok) throw new Error();
                    auditData = await res.json();
                    document.getElementById('det-shell').classList.remove('d-none');
                    document.getElementById('det-head').innerHTML = `
                        <div class="d-flex flex-wrap justify-content-between gap-3">
                            <div>
                                <p class="small text-uppercase mb-1" style="letter-spacing:.15em;color:var(--ap-muted)">Auditoría</p>
                                <h1 class="h3 text-white mb-2">${safe(auditData.title)}</h1>
                                <p class="mb-0 small" style="color:var(--ap-muted)">Sede: <strong class="text-white">${safe(auditData.sede)}</strong>
                                · Estado: <span class="badge audit-status-${(auditData.status || '').toLowerCase()}">${safe(auditData.status)}</span></p>
                            </div>
                            <div class="text-md-end small" style="color:var(--ap-muted)">
                                ${auditData.internalName ? '<div><strong>Ref:</strong> ' + safe(auditData.internalName) + '</div>' : ''}
                            </div>
                        </div>`;
                } catch {
                    show('Error al cargar la auditoría.', false);
                }
            }

            document.getElementById('btn-open-acta').addEventListener('click', openActa);
            document.getElementById('acta-modal-close').addEventListener('click', closeActa);
            document.getElementById('acta-modal-close-2').addEventListener('click', closeActa);
            document.getElementById('acta-modal-backdrop').addEventListener('click', closeActa);

            document.getElementById('acta-btn-save').addEventListener('click', async () => {
                if (!auditData) return;
                const sets = document.querySelectorAll('#acta-modal-body fieldset.acta-item');
                const items = [];
                for (const fs of sets) {
                    const id = parseInt(fs.getAttribute('data-item-id'), 10);
                    const r = fs.querySelector('input[type="radio"]:checked');
                    if (!r) {
                        show('Completa la calificación (A / AR / I) en todos los aspectos antes de guardar.', false);
                        return;
                    }
                    const obs = fs.querySelector('[data-obs-for="' + id + '"]');
                    items.push({ id: id, score: parseFloat(r.value), observations: obs ? (obs.value || null) : null });
                }
                try {
                    const res = await fetch(API + '/audits/' + AUDIT_ID + '/items', {
                        method: 'PUT',
                        headers: { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json' },
                        body: JSON.stringify(items)
                    });
                    if (res.ok) {
                        show('Acta guardada correctamente.', true);
                        const data = await fetch(API + '/audits/' + AUDIT_ID, { headers: { 'Authorization': 'Bearer ' + token } }).then(r => r.json());
                        auditData = data;
                        closeActa();
                    } else show('No se pudo guardar.', false);
                } catch { show('Error de red.', false); }
            });

            load();
        })();
    </script>
}

@page
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = "Panel";
    var apiBase = (Configuration["ApiBaseUrl"] ?? "http://localhost:5141").TrimEnd('/');
}

<div class="hero-panel">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
        <div>
            <p class="small text-uppercase mb-1" style="letter-spacing: .18em; color: var(--ap-muted);">Panel principal</p>
            <h1 class="h2 mb-1 text-white">Hola, <span id="dash-name" class="text-gradient">…</span></h1>
            <p class="mb-0 small" id="dash-subtitle" style="color: var(--ap-muted);">Cargando…</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <button type="button" class="btn btn-glow" id="btn-refresh">↻ Actualizar</button>
            <a class="btn btn-glow" href="@($"{apiBase}/swagger")" target="_blank" rel="noopener">Swagger</a>
        </div>
    </div>
</div>

<div id="dash-banner" class="alert alert-info border-0 mb-4 d-none" style="background: rgba(108,140,255,.12); color: #dbe4ff;"></div>

<div id="dash-stats-row" class="row g-4 mb-2 d-none" aria-hidden="true">
    <div class="col-md-3 col-6">
        <div class="glass-card p-4 text-center h-100">
            <div class="stat-label">Auditorías</div>
            <div class="stat-value" id="stat-total">—</div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="glass-card p-4 text-center h-100">
            <div class="stat-label">Aprobadas</div>
            <div class="stat-value" id="stat-approved">—</div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="glass-card p-4 text-center h-100">
            <div class="stat-label">Borradores</div>
            <div class="stat-value" id="stat-drafts">—</div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="glass-card p-4 text-center h-100">
            <div class="stat-label">Avance</div>
            <div class="stat-value" id="stat-rate">—</div>
        </div>
    </div>
</div>

@* ——— ADMIN: creación + listado ——— *@
<div id="dash-admin-root" class="d-none">
    <div class="dash-flow-step glass-card border-0 p-4 p-md-5 mb-4">
        <h2 class="h4 text-white mb-2">Nueva auditoría</h2>
        <p class="small mb-4" style="color: var(--ap-muted);">Completa los datos y asígnala a un auditor si lo necesitas.</p>

        <div id="dash-form-alert" class="alert d-none mb-3 border-0"></div>

        <form id="dash-audit-form">
            <div class="row g-3">
                <div class="col-md-8">
                    <label class="form-label small text-uppercase" style="color:var(--ap-muted)">Título</label>
                    <input class="form-control form-control-lg audit-input" name="title" required maxlength="200" placeholder="Ej. Auditoría sede centro" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small text-uppercase" style="color:var(--ap-muted)">Fecha visita</label>
                    <input class="form-control audit-input" name="scheduledVisitDate" type="datetime-local" />
                </div>
                <div class="col-md-6">
                    <label class="form-label small text-uppercase" style="color:var(--ap-muted)">Nombre / referencia</label>
                    <input class="form-control audit-input" name="internalName" maxlength="200" placeholder="Código o referencia interna" />
                </div>
                <div class="col-md-6">
                    <label class="form-label small text-uppercase" style="color:var(--ap-muted)">Sede</label>
                    <input class="form-control audit-input" name="sede" required maxlength="200" placeholder="Sede o punto auditado" />
                </div>
                <div class="col-12">
                    <label class="form-label small text-uppercase" style="color:var(--ap-muted)">Descripción</label>
                    <textarea class="form-control audit-input" name="description" rows="2" placeholder="Contexto de la visita"></textarea>
                </div>
                <div class="col-12">
                    <label class="form-label small text-uppercase" style="color:var(--ap-muted)">Comentarios</label>
                    <textarea class="form-control audit-input" name="comments" rows="2" placeholder="Observaciones previas…"></textarea>
                </div>
                <div class="col-12">
                    <label class="form-label small text-uppercase" style="color:var(--ap-muted)">Asignar a auditor (al crear)</label>
                    <select class="form-select audit-input" id="dash-assignee" name="assignedToUserId">
                        <option value="">— Sin asignar —</option>
                    </select>
                </div>
            </div>
            <div class="mt-4 d-flex flex-wrap gap-2 align-items-center">
                <button type="submit" class="btn btn-gradient px-4" id="dash-btn-save">Crear auditoría</button>
                <button type="button" class="btn btn-glow btn-sm" id="dash-btn-clear">Limpiar</button>
            </div>
        </form>
    </div>

    <div class="glass-card border-0 p-4 p-md-5 mb-4">
        <h2 class="h4 text-white mb-3">Auditorías creadas</h2>
        <p class="small mb-3" style="color: var(--ap-muted);">Todas las visitas registradas. Reasigna al auditor desde cada fila si hace falta.</p>
        <div id="dash-recent-wrap" style="min-height: 4rem;">
            <p class="small mb-0" style="color: var(--ap-muted);" id="dash-recent-placeholder">Cargando…</p>
        </div>
    </div>
</div>

@* ——— AUDITOR: solo asignadas ——— *@
<div id="dash-auditor-root" class="d-none">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="h4 text-white mb-1">Asignadas a ti</h2>
            <p class="small mb-0" style="color: var(--ap-muted);">Son las que un administrador te delegó. Abre el checklist para calificar.</p>
        </div>
    </div>

    <div id="dash-auditor-alert" class="alert d-none mb-3 border-0"></div>

    <div class="glass-card border-0 p-4 p-md-5 mb-4">
        <h3 class="h6 text-uppercase mb-3" style="letter-spacing: .12em; color: var(--ap-muted);">En tu bandeja</h3>
        <div id="dash-auditor-assigned-wrap" style="min-height: 4rem;">
            <p class="small mb-0" style="color: var(--ap-muted);">Cargando…</p>
        </div>
    </div>
</div>

@* ——— CLIENTE u otros ——— *@
<div id="dash-client-root" class="glass-card border-0 p-4 p-md-5 mb-4 d-none">
    <p class="mb-2 text-white fw-semibold">Vista limitada</p>
    <p class="small mb-3" style="color: var(--ap-muted);">Tu rol no incluye crear ni ver estadísticas globales. Usa el listado para lo que te corresponda.</p>
    <a class="btn btn-glow" asp-page="/Auditorias/Index">Ir a auditorías</a>
</div>

@section Scripts {
    <script>
        (function () {
            const API_BASE = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(apiBase));
            const token = sessionStorage.getItem('audit_access_token');
            const role = (sessionStorage.getItem('audit_user_role') || '').trim();
            const name = sessionStorage.getItem('audit_user_name');
            document.getElementById('dash-name').textContent = name || 'invitado';

            const banner = document.getElementById('dash-banner');
            const statsRow = document.getElementById('dash-stats-row');
            const adminRoot = document.getElementById('dash-admin-root');
            const auditorRoot = document.getElementById('dash-auditor-root');
            const clientRoot = document.getElementById('dash-client-root');
            const subtitle = document.getElementById('dash-subtitle');

            const isAdmin = role === 'ADMIN';
            const isAuditor = role === 'AUDITOR';
            const isClient = !isAdmin && !isAuditor;

            function showBanner(msg, kind) {
                banner.className = 'alert mb-4 border-0 ' + (kind === 'err' ? 'alert-danger' : 'alert-info');
                banner.style.background = kind === 'err' ? 'rgba(255,107,138,.15)' : 'rgba(108,140,255,.12)';
                banner.style.color = kind === 'err' ? '#ffc4d0' : '#dbe4ff';
                banner.textContent = msg;
                banner.classList.remove('d-none');
            }

            function formAlert(msg, ok, checklistId) {
                const el = document.getElementById('dash-form-alert');
                if (!el) return;
                el.className = 'alert mb-3 border-0 ' + (ok ? 'alert-success' : 'alert-danger');
                el.style.background = ok ? 'rgba(61,214,140,.15)' : 'rgba(255,107,138,.12)';
                el.style.color = ok ? '#b8ffd9' : '#ffc4d0';
                el.textContent = msg;
                el.classList.remove('d-none');
                if (ok && checklistId) {
                    const a = document.createElement('a');
                    a.href = '/Auditorias/Detalle/' + checklistId;
                    a.className = 'btn btn-sm btn-gradient mt-2';
                    a.textContent = 'Abrir checklist ahora';
                    el.appendChild(document.createElement('br'));
                    el.appendChild(a);
                }
            }

            function auditorAlert(msg, ok) {
                const el = document.getElementById('dash-auditor-alert');
                if (!el) return;
                el.className = 'alert mb-3 border-0 ' + (ok ? 'alert-success' : 'alert-danger');
                el.style.background = ok ? 'rgba(61,214,140,.15)' : 'rgba(255,107,138,.12)';
                el.style.color = ok ? '#b8ffd9' : '#ffc4d0';
                el.textContent = msg;
                el.classList.remove('d-none');
            }

            if (!token) {
                showBanner('Inicia sesión para usar el panel.', 'err');
                subtitle.textContent = 'Sin sesión activa.';
                return;
            }

            if (isAdmin) {
                adminRoot.classList.remove('d-none');
                subtitle.textContent = 'Crea y asigna auditorías.';
            } else if (isAuditor) {
                auditorRoot.classList.remove('d-none');
                subtitle.textContent = 'Auditorías que te asignó un administrador.';
            } else {
                clientRoot.classList.remove('d-none');
                subtitle.textContent = 'Acceso acotado según tu rol.';
            }

            let auditors = [];

            function escapeHtml(s) {
                return String(s || '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
            }

            function auditorOptionsHtml(selectedId) {
                let h = '<option value="">— Sin asignar —</option>';
                (auditors || []).forEach(u => {
                    const sel = String(u.id) === String(selectedId || '') ? ' selected' : '';
                    h += '<option value="' + u.id + '"' + sel + '>' + escapeHtml(u.name + ' · ' + u.email) + '</option>';
                });
                return h;
            }

            async function loadAuditors() {
                if (!isAdmin) return;
                try {
                    const res = await fetch(API_BASE + '/auth/auditors', { headers: { 'Authorization': 'Bearer ' + token } });
                    auditors = res.ok ? await res.json() : [];
                    const sel = document.getElementById('dash-assignee');
                    if (!sel) return;
                    sel.innerHTML = '<option value="">— Sin asignar —</option>';
                    (auditors || []).forEach(u => {
                        const o = document.createElement('option');
                        o.value = u.id;
                        o.textContent = u.name + ' · ' + u.email;
                        sel.appendChild(o);
                    });
                } catch { auditors = []; }
            }

            async function loadRecentAudits() {
                const wrap = document.getElementById('dash-recent-wrap');
                if (!wrap) return;
                const ph = document.getElementById('dash-recent-placeholder');
                if (ph) ph.textContent = 'Cargando…';
                try {
                    const res = await fetch(API_BASE + '/audits', { headers: { 'Authorization': 'Bearer ' + token } });
                    if (!res.ok) throw new Error();
                    const data = await res.json();
                    if (!data.length) {
                        wrap.innerHTML = '<p class="small mb-0" style="color:var(--ap-muted)">Aún no hay auditorías.</p>';
                        return;
                    }
                    wrap.innerHTML = '<ul class="list-unstyled mb-0 dash-recent-list">' + data.map(a => {
                        const assignBlock = '<div class="mt-2 d-flex flex-wrap gap-2 align-items-center">' +
                            '<select class="form-select form-select-sm audit-input dash-row-assign" data-audit-id="' + a.id + '">' + auditorOptionsHtml(a.assignedToUserId) + '</select>' +
                            '<button type="button" class="btn btn-sm btn-glow dash-row-assign-btn" data-audit-id="' + a.id + '">Asignar</button>' +
                            '<button type="button" class="btn btn-sm btn-outline-danger dash-row-delete-btn" data-audit-id="' + a.id + '">Eliminar</button></div>';
                        return '<li class="dash-recent-item pb-3 mb-3 border-bottom border-secondary border-opacity-25">' +
                            '<div class="d-flex justify-content-between gap-2 flex-wrap">' +
                            '<div><span class="badge rounded-pill audit-status-' + String(a.status || '').toLowerCase() + '">' + escapeHtml(a.status || '') + '</span>' +
                            '<div class="fw-semibold text-white mt-1">' + escapeHtml(a.title) + '</div>' +
                            '<div class="small" style="color:var(--ap-muted)">' + escapeHtml(a.sede || '') + ' · ' + escapeHtml(a.assignedToUserName || 'Sin asignar') + '</div></div>' +
                            '<a class="btn btn-sm btn-gradient align-self-start" href="/Auditorias/Detalle/' + a.id + '">Acta / PDF</a></div>' + assignBlock + '</li>';
                    }).join('') + '</ul>';

                    wrap.querySelectorAll('.dash-row-delete-btn').forEach(btn => {
                        btn.addEventListener('click', async () => {
                            const id = parseInt(btn.getAttribute('data-audit-id'), 10);
                            if (!confirm('¿Eliminar esta auditoría? No se puede deshacer.')) return;
                            btn.disabled = true;
                            try {
                                const r = await fetch(API_BASE + '/audits/' + id, {
                                    method: 'DELETE',
                                    headers: { 'Authorization': 'Bearer ' + token }
                                });
                                if (r.status === 204 || r.ok) {
                                    formAlert('Auditoría eliminada.', true);
                                    await loadRecentAudits();
                                } else if (r.status === 405) {
                                    formAlert('Eliminar no disponible: reinicia la API (Ctrl+C y dotnet run).', false);
                                } else formAlert('No se pudo eliminar (HTTP ' + r.status + ').', false);
                            } catch { formAlert('Error de red.', false); }
                            finally { btn.disabled = false; }
                        });
                    });

                    wrap.querySelectorAll('.dash-row-assign-btn').forEach(btn => {
                        btn.addEventListener('click', async () => {
                            const id = parseInt(btn.getAttribute('data-audit-id'), 10);
                            const row = wrap.querySelector('.dash-row-assign[data-audit-id="' + id + '"]');
                            const val = row ? row.value : '';
                            if (!val) { formAlert('Elige un auditor.', false); return; }
                            btn.disabled = true;
                            try {
                                const r = await fetch(API_BASE + '/audits/' + id + '/assign', {
                                    method: 'PUT',
                                    headers: { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json' },
                                    body: JSON.stringify({ assignedToUserId: parseInt(val, 10) })
                                });
                                const t = await r.text();
                                let d = {}; try { d = t ? JSON.parse(t) : {}; } catch { }
                                if (!r.ok) { formAlert(d.error || 'No se pudo asignar.', false); return; }
                                formAlert('Asignación guardada.', true);
                                await loadRecentAudits();
                            } catch {
                                formAlert('Error de red.', false);
                            } finally {
                                btn.disabled = false;
                            }
                        });
                    });
                } catch {
                    wrap.innerHTML = '<p class="small text-danger mb-0">No se pudo cargar el listado.</p>';
                }
            }

            function renderAuditList(audits, emptyMsg) {
                if (!audits.length) return '<p class="small mb-0" style="color:var(--ap-muted)">' + escapeHtml(emptyMsg) + '</p>';
                return '<ul class="list-unstyled mb-0 dash-recent-list">' + audits.map(a =>
                    '<li class="dash-recent-item pb-3 mb-3 border-bottom border-secondary border-opacity-25">' +
                    '<div class="d-flex justify-content-between gap-2 flex-wrap align-items-start">' +
                    '<div><span class="badge rounded-pill audit-status-' + String(a.status || '').toLowerCase() + '">' + escapeHtml(a.status || '') + '</span>' +
                    '<div class="fw-semibold text-white mt-1">' + escapeHtml(a.title) + '</div>' +
                    '<div class="small" style="color:var(--ap-muted)">' + escapeHtml(a.sede || '') + '</div></div>' +
                    '<a class="btn btn-sm btn-gradient" href="/Auditorias/Detalle/' + a.id + '">Checklist</a></div></li>'
                ).join('') + '</ul>';
            }

            async function loadAuditorAudits() {
                const wA = document.getElementById('dash-auditor-assigned-wrap');
                try {
                    const res = await fetch(API_BASE + '/audits', { headers: { 'Authorization': 'Bearer ' + token } });
                    if (!res.ok) throw new Error();
                    const all = await res.json();
                    wA.innerHTML = renderAuditList(all, 'Nada asignado a ti por ahora. Cuando un admin te delegue una visita, aparecerá aquí.');
                } catch {
                    wA.innerHTML = '<p class="small text-danger mb-0">No se pudo cargar.</p>';
                }
            }

            document.getElementById('btn-refresh').addEventListener('click', async () => {
                if (isAdmin) {
                    await loadAuditors();
                    await loadRecentAudits();
                } else if (isAuditor) {
                    await loadAuditorAudits();
                }
            });

            document.getElementById('dash-btn-clear')?.addEventListener('click', () => {
                document.getElementById('dash-audit-form')?.reset();
                document.getElementById('dash-form-alert')?.classList.add('d-none');
            });

            document.getElementById('dash-audit-form')?.addEventListener('submit', async (e) => {
                e.preventDefault();
                const fd = new FormData(e.target);
                const body = {
                    title: fd.get('title'),
                    internalName: fd.get('internalName') || null,
                    sede: fd.get('sede'),
                    description: fd.get('description') || null,
                    comments: fd.get('comments') || null,
                    scheduledVisitDate: fd.get('scheduledVisitDate') || null
                };
                const asg = document.getElementById('dash-assignee')?.value;
                if (asg) body.assignedToUserId = parseInt(asg, 10);

                const btn = document.getElementById('dash-btn-save');
                btn.disabled = true;
                try {
                    const res = await fetch(API_BASE + '/audits', {
                        method: 'POST',
                        headers: { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json' },
                        body: JSON.stringify(body)
                    });
                    const txt = await res.text();
                    let data = {}; try { data = txt ? JSON.parse(txt) : {}; } catch { }
                    if (res.status === 401) { formAlert('Sesión inválida.', false); return; }
                    if (res.status === 403) { formAlert('Sin permiso para crear.', false); return; }
                    if (!res.ok) { formAlert(data.error || 'No se pudo guardar.', false); return; }
                    formAlert('Auditoría creada.', true, data.id);
                    e.target.reset();
                    await loadRecentAudits();
                } catch {
                    formAlert('Sin conexión con la API.', false);
                } finally {
                    btn.disabled = false;
                }
            });

            (async function init() {
                if (isAdmin) {
                    await loadAuditors();
                    await loadRecentAudits();
                } else if (isAuditor) {
                    await loadAuditorAudits();
                }
            })();
        })();
    </script>
}

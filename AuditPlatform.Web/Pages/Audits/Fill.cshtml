@page "/Audits/Fill"
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = "Formato de auditoría";
    var apiBase = (Configuration["ApiBaseUrl"] ?? "http://localhost:5141").TrimEnd('/');
}

<div id="fill-alert" class="alert d-none mb-3"></div>

<div id="fill-header" class="hero-panel mb-4 d-none">
    <h1 class="h4 text-white mb-1" id="fill-title"></h1>
    <p class="small mb-0" id="fill-meta" style="color: var(--ap-muted);"></p>
</div>

<div id="fill-items" class="audit-fill-stack"></div>

<div class="glass-card p-4 mt-4 d-flex flex-wrap gap-2 justify-content-between align-items-center">
    <span class="small" style="color:var(--ap-muted)" id="fill-progress"></span>
    <div class="d-flex gap-2">
        <a class="btn btn-glow" asp-page="/Audits/Index">Volver</a>
        <button type="button" class="btn btn-gradient" id="btn-save-fill">Guardar avances</button>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const API = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(apiBase));
            const token = sessionStorage.getItem('audit_access_token');
            const params = new URLSearchParams(window.location.search);
            const id = params.get('id');
            if (!token || !id) { window.location.href = '/Login'; return; }

            const alert = document.getElementById('fill-alert');
            const stack = document.getElementById('fill-items');
            let audit = null;

            function escapeHtml(s) {
                return String(s || '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
            }

            async function load() {
                try {
                    const res = await fetch(API + '/audits/' + id, { headers: { 'Authorization': 'Bearer ' + token } });
                    if (res.status === 401) { window.location.href = '/Login'; return; }
                    if (res.status === 404) {
                        alert.className = 'alert alert-warning';
                        alert.textContent = 'No tienes acceso a esta auditoría o no existe.';
                        alert.classList.remove('d-none');
                        return;
                    }
                    audit = await res.json();
                    document.getElementById('fill-header').classList.remove('d-none');
                    document.getElementById('fill-title').textContent = audit.title || audit.Title;
                    const sede = audit.sede || audit.Sede || '';
                    const st = audit.scheduledVisitDate || audit.ScheduledVisitDate || '';
                    document.getElementById('fill-meta').textContent = (sede ? ('Sede: ' + sede + ' · ') : '') + (st ? ('Visita: ' + st) : 'Sin fecha programada');

                    const items = audit.items || audit.Items || [];
                    const byCat = {};
                    items.forEach(it => {
                        const c = it.category || it.Category || 'General';
                        if (!byCat[c]) byCat[c] = [];
                        byCat[c].push(it);
                    });
                    stack.innerHTML = '';
                    Object.keys(byCat).sort().forEach(cat => {
                        const sec = document.createElement('section');
                        sec.className = 'mb-4 audit-section-enter';
                        sec.innerHTML = '<h2 class="h6 text-uppercase mb-3" style="letter-spacing:.12em;color:var(--ap-accent)">' + escapeHtml(cat) + '</h2>';
                        const inner = document.createElement('div');
                        inner.className = 'd-flex flex-column gap-3';
                        byCat[cat].forEach((it, idx) => {
                            const iid = it.id ?? it.Id;
                            const label = it.label || it.Label;
                            const code = it.code || it.Code;
                            const w = it.weight ?? it.Weight ?? 0;
                            let sc = it.score ?? it.Score ?? 0;
                            const obs = it.observations ?? it.Observations ?? '';
                            const row = document.createElement('div');
                            row.className = 'glass-card p-4 audit-fill-row';
                            row.dataset.itemId = iid;
                            row.innerHTML =
                                '<div class="d-flex flex-wrap justify-content-between gap-2 mb-2">' +
                                '<div><span class="badge bg-secondary me-2">' + escapeHtml(code) + '</span><strong class="text-white">' + escapeHtml(label) + '</strong></div>' +
                                '<span class="small" style="color:var(--ap-muted)">Peso rubrica: ' + w + '</span></div>' +
                                '<label class="form-label small">Puntuación (0–100)</label>' +
                                '<div class="d-flex align-items-center gap-3 flex-wrap">' +
                                '<input type="range" class="form-range flex-grow-1 audit-range" min="0" max="100" step="0.5" value="' + sc + '" data-score />' +
                                '<input type="number" class="form-control form-control-sm bg-dark text-white border-secondary audit-num" style="width:88px" min="0" max="100" step="0.5" value="' + sc + '" data-num />' +
                                '</div>' +
                                '<label class="form-label small mt-2">Observaciones</label>' +
                                '<textarea class="form-control bg-dark text-white border-secondary" rows="2" data-obs>' + escapeHtml(obs) + '</textarea>';
                            inner.appendChild(row);
                            const r = row.querySelector('[data-score]');
                            const n = row.querySelector('[data-num]');
                            const sync = v => { r.value = v; n.value = v; };
                            r.addEventListener('input', () => sync(r.value));
                            n.addEventListener('input', () => sync(n.value));
                        });
                        sec.appendChild(inner);
                        stack.appendChild(sec);
                    });
                    updateProgress();
                } catch {
                    alert.className = 'alert alert-danger';
                    alert.textContent = 'Error de conexión.';
                    alert.classList.remove('d-none');
                }
            }

            function updateProgress() {
                const rows = stack.querySelectorAll('.audit-fill-row');
                let n = 0, sum = 0;
                rows.forEach(row => {
                    n++;
                    sum += parseFloat(row.querySelector('[data-score]').value) || 0;
                });
                document.getElementById('fill-progress').textContent = n ? ('Promedio numérico aprox.: ' + (sum / n).toFixed(1) + ' / 100 por ítem') : '';
            }
            stack.addEventListener('input', e => { if (e.target.matches('[data-score], [data-num]')) updateProgress(); });

            document.getElementById('btn-save-fill').addEventListener('click', async () => {
                const rows = stack.querySelectorAll('.audit-fill-row');
                const payload = [];
                rows.forEach(row => {
                    payload.push({
                        id: parseInt(row.dataset.itemId, 10),
                        score: parseFloat(row.querySelector('[data-score]').value),
                        observations: row.querySelector('[data-obs]').value || null
                    });
                });
                const res = await fetch(API + '/audits/' + id + '/items', {
                    method: 'PUT',
                    headers: { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                if (res.status === 403) {
                    alert.className = 'alert alert-warning';
                    alert.textContent = 'No tienes permiso para editar esta auditoría.';
                    alert.classList.remove('d-none');
                    return;
                }
                if (!res.ok) {
                    const d = await res.json().catch(() => ({}));
                    alert.className = 'alert alert-danger';
                    alert.textContent = d.error || 'Error al guardar';
                    alert.classList.remove('d-none');
                    return;
                }
                alert.className = 'alert alert-success';
                alert.textContent = 'Cambios guardados correctamente.';
                alert.classList.remove('d-none');
                setTimeout(() => alert.classList.add('d-none'), 2800);
            });

            load();
        })();
    </script>
}

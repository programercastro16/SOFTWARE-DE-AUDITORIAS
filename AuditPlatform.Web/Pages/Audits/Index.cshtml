@page "/Audits"
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = "Auditorías";
    var apiBase = (Configuration["ApiBaseUrl"] ?? "http://localhost:5141").TrimEnd('/');
}

<section class="hero-panel mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <p class="small text-uppercase mb-1" style="letter-spacing: .18em; color: var(--ap-muted);">Operación</p>
            <h1 class="h3 mb-0 text-white">Mis auditorías</h1>
            <p class="small mb-0" style="color: var(--ap-muted);">Según tu rol: el admin ve todo; el auditor ve las que creó o le asignaron.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-glow" asp-page="/Audits/Create" id="btn-new-audit" style="display:none">Nueva auditoría</a>
            <a class="btn btn-glow" asp-page="/Dashboard">Panel</a>
        </div>
    </div>
</section>

<div id="audits-alert" class="alert d-none mb-3"></div>
<div id="audits-list" class="row g-3"></div>

@section Scripts {
    <script>
        (function () {
            const API = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(apiBase));
            const token = sessionStorage.getItem('audit_access_token');
            const role = sessionStorage.getItem('audit_user_role') || '';
            if (!token) { window.location.href = '/Login'; return; }
            if (role === 'ADMIN' || role === 'AUDITOR')
                document.getElementById('btn-new-audit').style.display = 'inline-block';

            async function load() {
                const wrap = document.getElementById('audits-list');
                const alert = document.getElementById('audits-alert');
                try {
                    const res = await fetch(API + '/audits', { headers: { 'Authorization': 'Bearer ' + token } });
                    if (res.status === 401) { window.location.href = '/Login'; return; }
                    const data = await res.json();
                    wrap.innerHTML = '';
                    if (!data.length) {
                        wrap.innerHTML = '<div class="col-12"><div class="glass-card p-4 text-center" style="color:var(--ap-muted)">No hay auditorías. Crea una como auditor o espera asignación.</div></div>';
                        return;
                    }
                    data.forEach((a, i) => {
                        const assigned = a.assignedToUserName ? ('Asignada a: ' + escapeHtml(a.assignedToUserName)) : 'Sin asignar';
                        const createdBy = 'Creada por: ' + escapeHtml(a.createdBy);
                        const card = document.createElement('div');
                        card.className = 'col-md-6 col-lg-4';
                        card.style.animationDelay = (i * 0.06) + 's';
                        card.innerHTML =
                            '<div class="glass-card p-4 h-100 audit-card-enter">' +
                            '<div class="d-flex justify-content-between align-items-start mb-2">' +
                            '<span class="badge rounded-pill audit-status">' + escapeHtml(a.status) + '</span>' +
                            (role === 'ADMIN' ? '<a class="btn btn-sm btn-glow" href="/Audits/Assign?id=' + a.id + '">Asignar</a>' : '') +
                            '</div>' +
                            '<h3 class="h6 text-white mb-1">' + escapeHtml(a.title) + '</h3>' +
                            '<p class="small mb-2" style="color:var(--ap-muted)">' + escapeHtml(a.sede || '') + '</p>' +
                            '<p class="small mb-1">' + assigned + '</p>' +
                            '<p class="small mb-3" style="color:var(--ap-muted)">' + createdBy + '</p>' +
                            '<div class="d-flex gap-2 flex-wrap">' +
                            '<a class="btn btn-sm btn-gradient" href="/Audits/Fill?id=' + a.id + '">Llenar formato</a>' +
                            '</div></div>';
                        wrap.appendChild(card);
                    });
                } catch (e) {
                    alert.className = 'alert alert-danger';
                    alert.textContent = 'No se pudo conectar con la API.';
                    alert.classList.remove('d-none');
                }
            }
            function escapeHtml(s) {
                return String(s || '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
            }
            load();
        })();
    </script>
}

@page "/Audits/Assign"
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = "Asignar auditoría";
    var apiBase = (Configuration["ApiBaseUrl"] ?? "http://localhost:5141").TrimEnd('/');
}

<section class="hero-panel mb-4">
    <h1 class="h3 text-white mb-1">Asignar auditoría</h1>
    <p class="small mb-0" style="color: var(--ap-muted);">Elige un auditor. Solo administradores.</p>
</section>

<div id="assign-alert" class="alert d-none mb-3"></div>

<div class="glass-card p-4 p-md-5 audit-form-enter" style="max-width:520px">
    <p class="small mb-3" style="color:var(--ap-muted)">Auditoría #<span id="aid">—</span></p>
    <label class="form-label">Auditor</label>
    <select id="auditor-select" class="form-select form-select-lg bg-dark text-white border-secondary mb-4"></select>
    <button type="button" class="btn btn-gradient w-100" id="btn-assign">Guardar asignación</button>
    <a class="btn btn-glow w-100 mt-2" asp-page="/Audits/Index">Cancelar</a>
</div>

@section Scripts {
    <script>
        (function () {
            const API = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(apiBase));
            const token = sessionStorage.getItem('audit_access_token');
            const role = sessionStorage.getItem('audit_user_role') || '';
            const params = new URLSearchParams(window.location.search);
            const id = params.get('id');
            if (!token || role !== 'ADMIN' || !id) {
                window.location.href = role === 'ADMIN' ? '/Audits' : '/Login';
                return;
            }
            document.getElementById('aid').textContent = id;
            const alert = document.getElementById('assign-alert');
            const sel = document.getElementById('auditor-select');

            fetch(API + '/auth/users/auditors', { headers: { 'Authorization': 'Bearer ' + token } })
                .then(r => r.json())
                .then(list => {
                    sel.innerHTML = '<option value="">— Selecciona —</option>';
                    (list || []).forEach(u => {
                        const o = document.createElement('option');
                        o.value = u.id ?? u.Id;
                        o.textContent = (u.name || u.Name) + ' · ' + (u.email || u.Email);
                        sel.appendChild(o);
                    });
                })
                .catch(() => {
                    alert.className = 'alert alert-danger';
                    alert.textContent = 'No se pudieron cargar auditores.';
                    alert.classList.remove('d-none');
                });

            document.getElementById('btn-assign').addEventListener('click', async () => {
                const v = sel.value;
                if (!v) return;
                const res = await fetch(API + '/audits/' + id + '/assign', {
                    method: 'PUT',
                    headers: { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json' },
                    body: JSON.stringify({ assignedToUserId: parseInt(v, 10) })
                });
                const data = await res.json().catch(() => ({}));
                if (!res.ok) {
                    alert.className = 'alert alert-danger';
                    alert.textContent = data.error || 'Error ' + res.status;
                    alert.classList.remove('d-none');
                    return;
                }
                window.location.href = '/Audits';
            });
        })();
    </script>
}

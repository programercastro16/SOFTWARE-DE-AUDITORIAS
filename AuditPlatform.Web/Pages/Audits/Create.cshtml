@page "/Audits/Create"
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = "Nueva auditoría";
    var apiBase = (Configuration["ApiBaseUrl"] ?? "http://localhost:5141").TrimEnd('/');
}

<section class="hero-panel mb-4">
    <h1 class="h3 text-white mb-1">Nueva auditoría</h1>
    <p class="small mb-0" style="color: var(--ap-muted);">Completa los datos de la visita. Se generará el formato digital de calificación (checklist).</p>
</section>

<div id="create-alert" class="alert d-none mb-3"></div>

<form id="audit-form" class="glass-card p-4 p-md-5 audit-form-enter">
    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label small text-uppercase" style="color:var(--ap-muted)">Título</label>
            <input class="form-control form-control-lg bg-dark text-white border-secondary" name="title" required maxlength="200" placeholder="Ej. Auditoría sede Cuzco – Febrero" />
        </div>
        <div class="col-md-6">
            <label class="form-label small text-uppercase" style="color:var(--ap-muted)">Nombre / referencia</label>
            <input class="form-control form-control-lg bg-dark text-white border-secondary" name="internalName" maxlength="200" placeholder="Código interno opcional" />
        </div>
        <div class="col-md-6">
            <label class="form-label small text-uppercase" style="color:var(--ap-muted)">Sede <span class="text-danger">*</span></label>
            <input class="form-control form-control-lg bg-dark text-white border-secondary" name="sede" required maxlength="300" placeholder="Dirección o nombre del punto auditado" />
        </div>
        <div class="col-md-6">
            <label class="form-label small text-uppercase" style="color:var(--ap-muted)">Fecha programada</label>
            <input class="form-control form-control-lg bg-dark text-white border-secondary" name="scheduledVisitDate" type="datetime-local" />
        </div>
        <div class="col-12">
            <label class="form-label small text-uppercase" style="color:var(--ap-muted)">Descripción</label>
            <textarea class="form-control bg-dark text-white border-secondary" name="description" rows="3" placeholder="Alcance, normativa aplicable…"></textarea>
        </div>
        <div class="col-12">
            <label class="form-label small text-uppercase" style="color:var(--ap-muted)">Comentarios</label>
            <textarea class="form-control bg-dark text-white border-secondary" name="comments" rows="2" placeholder="Notas para el equipo o el administrador"></textarea>
        </div>
    </div>
    <div class="mt-4 d-flex flex-wrap gap-2">
        <button type="submit" class="btn btn-gradient px-4" id="btn-save">Guardar borrador</button>
        <a class="btn btn-glow" asp-page="/Audits/Index">Volver al listado</a>
    </div>
</form>

@section Scripts {
    <script>
        (function () {
            const API = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(apiBase));
            const token = sessionStorage.getItem('audit_access_token');
            const role = sessionStorage.getItem('audit_user_role') || '';
            if (!token || (role !== 'ADMIN' && role !== 'AUDITOR')) {
                window.location.href = '/Login';
                return;
            }
            const form = document.getElementById('audit-form');
            const alert = document.getElementById('create-alert');
            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                const fd = new FormData(form);
                const body = {
                    title: fd.get('title'),
                    internalName: fd.get('internalName') || null,
                    sede: fd.get('sede'),
                    description: fd.get('description') || null,
                    comments: fd.get('comments') || null,
                    scheduledVisitDate: fd.get('scheduledVisitDate') || null
                };
                const btn = document.getElementById('btn-save');
                btn.disabled = true;
                try {
                    const res = await fetch(API + '/audits', {
                        method: 'POST',
                        headers: { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json' },
                        body: JSON.stringify(body)
                    });
                    const data = await res.json().catch(() => ({}));
                    if (!res.ok) {
                        alert.className = 'alert alert-danger';
                        alert.textContent = data.error || ('Error ' + res.status);
                        alert.classList.remove('d-none');
                        btn.disabled = false;
                        return;
                    }
                    window.location.href = '/Audits/Fill?id=' + (data.id || data.Id);
                } catch {
                    alert.className = 'alert alert-danger';
                    alert.textContent = 'Sin conexión a la API.';
                    alert.classList.remove('d-none');
                    btn.disabled = false;
                }
            });
        })();
    </script>
}
